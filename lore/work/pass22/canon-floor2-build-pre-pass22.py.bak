 ledger_rows=['H-003', 'M-322'] + r('mh_look', 'mh_body', 'mh_psionic', 'mh_slow', 'mh_first', 'mh_guide', 'impaler', 'impaler_warn', 'x_impaler', 'f2_patch_hedgehog', 'f2_patch_hedgehog_why', 'blimp_boss', 'blimp_float', 'zev_ch35'),
