def slot_map_sans_pin(bud_data, floor, daynum):
    """Return (map_key, hash) from the budget file's slot maps for this day, reading
    <map>.spec_sha256_sans_pin_when_mapped (a string for a one-day map such as day05_slot_map, or a
    {"day-NN": hash} dict for a multi-day map such as day02_to_04_slot_map). Floor 1 maps only."""
    if not isinstance(bud_data, dict) or floor != 1:
        return None, None
    want = "day-%02d" % daynum
    for k, v in bud_data.items():
        if not (k.endswith("_slot_map") and isinstance(v, dict)):
            continue
        h = v.get("spec_sha256_sans_pin_when_mapped")
        if isinstance(h, dict) and want in h:
            return k, h[want]
        m = re.fullmatch(r"day(\d{2})_slot_map", k)
        if isinstance(h, str) and m and int(m.group(1)) == daynum:
            return k, h
    return None, None


def check_slot_map_provenance(spec, sans_pin, bud, rep):
    daynum = spec["day"]["number"]
    key, want = slot_map_sans_pin(getattr(bud, "data", None), spec["meta"].get("floor"), daynum)
    if not want:
        rep.warn("slot-map provenance", "no spec_sha256_sans_pin_when_mapped for day-%02d in %s; nothing to compare" % (daynum, B70))
    elif want == sans_pin:
        rep.ok("slot-map provenance", "meta.spec_sha256_sans_pin %s matches %s#%s.spec_sha256_sans_pin_when_mapped" % (sans_pin[:16], B70, key))
    else:
        rep.fail("slot-map provenance", "spec_sha256_sans_pin is %s but %s#%s.spec_sha256_sans_pin_when_mapped is %s (the spec content changed since Syndicate mapped it; ask Syndicate to re-sync, or run with --write-on-fail)" % (sans_pin, B70, key, want))


def main(argv=None):
    ap = argparse.ArgumentParser(description="Encounter Bot: validate a Day spec and write the day page + JSON.")
    ap.add_argument("--spec", required=True, help="path to the Day spec JSON")
    ap.add_argument("--out-dir", default=None, help="default floors/fNN/ where NN is meta.floor")
    ap.add_argument("--allow-other-floors", action="store_true", help="accepted for older commands; output still follows meta.floor")
    ap.add_argument("--check-only", action="store_true", help="validate only, write nothing")
    ap.add_argument("--write-on-fail", action="store_true", help="write outputs even if validation fails")
    a = ap.parse_args(argv)

    rep = Report()
    spec_path = a.spec if os.path.isabs(a.spec) else os.path.join(os.getcwd(), a.spec)
    raw = read_text(spec_path)
    spec = json.loads(raw)
    meta = spec.get("meta") if isinstance(spec, dict) else None
    data = Data(floor_number(meta.get("floor", 1)) if isinstance(meta, dict) else 1)
    required = ("meta", "clock", "day", "routes", "stairwell_key", "encounters", "pending_inputs")
    missing = [k for k in required if k not in spec]
    if missing:
        print("FAIL: spec missing keys %s" % missing)
        return 1
    for k, v in (("owner", "Encounter Bot"), ("status", "draft")):
        if spec["meta"].get(k) != v:
            rep.warn("front matter %s" % k, "expected '%s', got '%s'" % (v, spec["meta"].get(k)))
    upd_ = str(spec["meta"].get("updated", ""))
    try:
        ok_upd = dt.date.fromisoformat(upd_) <= dt.date.today()
    except ValueError:
        ok_upd = False
    if not ok_upd:
        rep.warn("front matter updated", "expected an ISO date (YYYY-MM-DD) not in the future, got '%s'" % upd_)
    if not str(spec["meta"].get("version", "")).startswith("0."):
        rep.warn("front matter version", "expected 0.x, got '%s'" % spec["meta"].get("version"))
    doc = build(spec, data, rep)
    sans_pin = spec_sha256_sans_pin(json.loads(raw))
    check_slot_map_provenance(spec, sans_pin, data.budget, rep)
    doc["meta"]["spec_sha256_sans_pin"] = sans_pin
    doc["meta"]["spec_sha256_sans_pin_method"] = SANS_PIN_METHOD
    doc["validation"] = {"result": "?", "pass": 0, "warn": 0, "fail": 0, "spec_sha256": hashlib.sha256(raw.encode("utf-8")).hexdigest(), "checks": []}
    check_md_audience(render_md(doc), doc, rep)  # provisional render; the build note is re-rendered below
    checks = [{"status": s, "check": c, "detail": d} for s, c, d in rep.items]
    doc["validation"] = {
        "result": "PASS" if rep.passed else "FAIL", "pass": rep.count("PASS"), "warn": rep.count("WARN"), "fail": rep.count("FAIL"),
        "spec_sha256": hashlib.sha256(raw.encode("utf-8")).hexdigest(), "checks": checks}
    doc["meta"]["spec_sha256_sans_pin"] = sans_pin
    doc["meta"]["spec_sha256_sans_pin_method"] = SANS_PIN_METHOD
    md = render_md(doc)

    for s, c, d in rep.items:
        print("%-4s %s%s" % (s, c, (": " + d) if d else ""))
    print("-" * 60)
    print("Encounter Bot validation: %s (%d PASS, %d WARN, %d FAIL)" % (
        doc["validation"]["result"], rep.count("PASS"), rep.count("WARN"), rep.count("FAIL")))
    print("Slots left empty on purpose: %d; proposal-flagged fields: %d" % (
        sum(1 for s in doc["slots"] if s["kind"] == "slot"), len(doc["proposal_fields"])))
    if a.check_only or (not rep.passed and not a.write_on_fail):
        print("Nothing written (%s)." % ("check-only" if a.check_only else "validation failed"))
        return 0 if rep.passed else 1
    n = "day-%02d" % doc["meta"]["day"]
    fl = floor_number(doc["meta"].get("floor", 1))
    out_dir = a.out_dir or floor_pages_dir(fl)
    kw = dict(floor=fl, days=doc["meta"]["days"], allow_other_floors=a.allow_other_floors)
    md_path = check_write_allowed(os.path.join(out_dir, n + ".md"), **kw)
    js_path = check_write_allowed(os.path.join(out_dir, n + ".json"), **kw)
    with open(md_path, "w", encoding="utf-8") as f:
        f.write(md if md.endswith("\n") else md + "\n")
    with open(js_path, "w", encoding="utf-8") as f:
        json.dump(doc, f, indent=2, ensure_ascii=False)
        f.write("\n")
    print("Wrote %s\nWrote %s" % (md_path, js_path))
    return 0 if rep.passed else 1


if __name__ == "__main__":
    sys.exit(main())
