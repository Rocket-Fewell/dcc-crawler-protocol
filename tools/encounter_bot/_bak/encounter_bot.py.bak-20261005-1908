def add_audience(doc, rep):
    """Structured audience marking, added on top of the existing tag fields (nothing is removed or renamed).
    Rule for consumers: default is GM-only. A player may see ONLY the fields named in audience_manifest.player_blocks;
    never print a whole block that contains one of them (blocks also hold GM metadata)."""
    blocks = []

    def add(path, kind, field, blk, **kw):
        if not isinstance(blk, dict):
            return
        ent = {"path": path, "kind": kind, "field": field}
        if "{hours}" in str(blk.get(field, "")):
            ent["needs_fill"] = ["hours"]
        ent.update(kw)
        blocks.append(ent)
        blk["audience"] = "player"
    for i, r in enumerate(doc["routes"]):
        for k, v in r.get("voice_lines", {}).items():
            # decision 032: only dry notices are System; route voice (twists/wins/color) is GM
            # gm_color stays gm_color; every other route voice_line is gm_narration (not route_voice_line)
            kind = "gm_color" if k == "gm_color" else "gm_narration"
            add("/routes/%d/voice_lines/%s" % (i, k), kind, "text", v)
    for i, e in enumerate(doc["encounters"]):
        for k, v in e.get("voice_lines", {}).items():
            # decision 032: system_intro = dry System notice by default; scene intros in
            # SYSTEM_INTRO_AS_GM_NARRATION are gm_narration; twists/wins = GM narration; gm_color unchanged
            if k == "gm_color":
                kind = "gm_color"
            elif k == "system_intro":
                kind = "gm_narration" if e["id"] in SYSTEM_INTRO_AS_GM_NARRATION else "system_notice"
            elif k == "system_registration":
                kind = "system_notice"  # registration is a dry System notice (decision 032)
            else:
                kind = "gm_narration"  # midpoint_twist, win, win_alt, and any other non-gm_color key
            add("/encounters/%d/voice_lines/%s" % (i, k), kind, "text", v, encounter=e["id"])
        for j, ln in enumerate((e.get("zone_color") or {}).get("lines", [])):
            add("/encounters/%d/zone_color/lines/%d" % (i, j), "zone_color", "text", ln, encounter=e["id"], optional=True)
        sp = e.get("set_piece_intro")
        if sp:
            add("/encounters/%d/set_piece_intro" % i, "set_piece", "paragraphs", sp, encounter=e["id"], set_piece=True,
                paragraphs_optional=[bool(q.get("optional")) for q in sp["paragraphs"]], text_field_joined="text")
            sp["gm_note_audience"] = "gm"
        for j, pa in enumerate(e.get("proposed_achievements", [])):
            if pa.get("narration_tag") == PF:
                blocks.append({"path": "/encounters/%d/proposed_achievements/%d" % (i, j), "kind": "achievement_narration", "field": "narration",
                               "encounter": e["id"], "show_only_when": "the achievement is awarded (proposal, GM discretion)"})
                pa["narration_audience"] = "player"; pa["audience"] = "gm"
        for key in ("map_in_the_mind", "quick_run", "carry_on"):
            if isinstance(e.get(key), dict):
                e[key]["audience"] = "gm"
        for key in ("loot_hooks", "achievement_hooks", "enemies", "crawler_hooks"):
            for q in e.get(key, []) or []:
                if isinstance(q, dict):
                    q["audience"] = "gm"
        if isinstance(e.get("zone_color"), dict) and e["zone_color"].get("gm_note"):
            e["zone_color"]["gm_note_audience"] = "gm"
        e["audience_default"] = "gm"
    d = doc["day"]
    def add_nested_gm_color(parent_path, parent_blk, **kw):
        """Nested notice gm_color is spoken GM color, not System (kind gm_color)."""
        if isinstance(parent_blk, dict) and isinstance(parent_blk.get("gm_color"), dict):
            add("%s/gm_color" % parent_path, "gm_color", "text", parent_blk["gm_color"], **kw)

    fe = d.get("floor_exit") or {}
    for key, kind in (("tomorrow_notice", "system_notice"), ("collapse_notice", "system_notice"), ("stairwell_opening", "system_notice")):
        add("/day/%s" % key, kind, "text", d.get(key))
        add_nested_gm_color("/day/%s" % key, d.get(key))
        if key == "collapse_notice" and isinstance(d.get(key), dict) and d[key].get("hours_note"):
            d[key]["hours_note_audience"] = "gm"
    # GM spot-check 2026-10-05: table warning is GM narration; always after collapse/tomorrow
    # (and stairwell_opening when present), before early_descent and the missed-floor system line.
    # Do not hitch this to the stairwell_opening key (Day 5 has floor_exit but no stairwell_opening).
    add("/day/floor_exit/gm_warning", "gm_narration", "text", fe.get("gm_warning"),
        note="key is named gm_warning but the text is read to the players by the GM, after collapse/tomorrow notices and before early descent / missed-floor system line; the GM-only warning is /day/gm_warning")
    ed = d.get("early_descent") or {}
    add("/day/early_descent/player_prompt", "system_notice", "text", ed.get("player_prompt"))
    add_nested_gm_color("/day/early_descent/player_prompt", ed.get("player_prompt"))
    add("/day/early_descent/free_window", "system_notice", "text", ed.get("free_window"))
    add_nested_gm_color("/day/early_descent/free_window", ed.get("free_window"))
    add("/day/floor_exit/system_line", "system_notice", "text", fe.get("system_line"))
    add_nested_gm_color("/day/floor_exit/system_line", fe.get("system_line"))
    for j, pa in enumerate(d.get("proposed_achievements", [])):
        if pa.get("narration_tag") == PF:
            blocks.append({"path": "/day/proposed_achievements/%d" % j, "kind": "achievement_narration", "field": "narration",
                           "show_only_when": "the achievement is awarded (proposal, GM discretion)"})
            pa["narration_audience"] = "player"; pa["audience"] = "gm"
    for key in ("gm_warning", "warning_checks"):
        if isinstance(d.get(key), dict):
            d[key]["audience"] = "gm"
    for r in doc["routes"]:
        for q in r.get("achievements", []) or []:
            q["audience"] = "gm"
    for q in ed.get("achievements", []) or []:
        q["audience"] = "gm"
    for q in (d.get("last_chance_hooks") or {}).get("achievements", []) or []:
        q["audience"] = "gm"
    for key in ("clock", "stairwell_key"):
        if isinstance(doc.get(key), dict):
            doc[key]["audience"] = "gm"
    for q in doc.get("pending_inputs", []):
        q["audience"] = "gm"
    doc["audience_manifest"] = {
        "schema": AUD_SCHEMA, "default": "gm",
        "rule": "Everything not listed in player_blocks is GM-only, including every key added later. Show a player only the named field of a listed block; never print a whole block (blocks carry GM metadata such as status, hours_note, gm_note, source).",
        "tag_mechanism": "Blocks carry tag: '[PLAYER-FACING]' or '[GM-FACING]' (also audience: 'player'|'gm'). Other tag values (inspired, canon, dash, pacing guide, ...) are provenance labels, not audiences. Inline '[GM-ONLY]' prefixes exist only inside GM-only fields.",
        "never_show_fields": AUD_NEVER,
        "player_blocks": blocks,
    }
    # completeness: every PF-tagged block is in the manifest and every manifest entry resolves
    listed = {b["path"] for b in blocks}
    stray = []

    def scan(o, path):
        if isinstance(o, dict):
            if o.get("tag") == PF and path not in listed and not path.endswith("/zone_color") and "/proposed_achievements/" not in path:
                stray.append(path)
            for k, v in o.items():
                scan(v, "%s/%s" % (path, k))
        elif isinstance(o, list):
            for i, v in enumerate(o):
                scan(v, "%s/%d" % (path, i))
    scan({k: doc[k] for k in ("routes", "encounters", "day")}, "")
    stray = [s for s in stray]
    bad_gm = [k for k in ("gm_warning", "warning_checks") if isinstance(d.get(k), dict) and d[k].get("tag") != "[GM-FACING]"]
    if stray or bad_gm:
        rep.fail("audience manifest", "[PLAYER-FACING] blocks missing from audience_manifest: %s %s" % (stray, bad_gm))
    else:
        rep.ok("audience manifest", "%d player-visible blocks listed in audience_manifest (default GM-only); every block tagged [PLAYER-FACING] is listed, GM blocks carry audience gm" % len(blocks))


def _get_path(doc, path):
    o = doc
    for k in path.strip("/").split("/"):
        o = o[int(k)] if isinstance(o, list) else o.get(k) if isinstance(o, dict) else None
    return o


def check_md_audience(md, doc, rep):
    """Rendered-page audience checks. FAIL if (a) a GM marker sits inside any player block from audience_manifest,
    (b) one .md line/bullet carries both [GM-ONLY] and [PLAYER-FACING], or (c) an achievement / proposed-achievement
    bullet carries an inline [GM-ONLY] note (it must be its own bullet). WARN on a doubled full stop ('..') in prose."""
    bad_pb, mixed, inline_ach, dots = [], [], [], []
    for b in doc.get("audience_manifest", {}).get("player_blocks", []):
        blk = _get_path(doc, b["path"])
        val = blk.get(b["field"]) if isinstance(blk, dict) else None
        if isinstance(val, list):
            val = " ".join(q.get("text", "") if isinstance(q, dict) else str(q) for q in val)
        if isinstance(val, str) and (GM in val or "[GM-FACING]" in val):
            bad_pb.append(b["path"])
    for n_, raw_ln in enumerate(md.splitlines(), 1):
        ln = re.sub(r"`[^`]*`", "", raw_ln)  # markers quoted in code spans (the Reading key legend) are not tags
        if GM in ln and PF in ln:
            mixed.append(n_)
        if GM in ln and re.match(r"\s*- \*\*(Achievement|Proposed achievement)", ln):
            inline_ach.append(n_)
        if not ln.lstrip().startswith(("|", "`")) and re.search(r"(?<!\.)\.\.(?![./])", ln):
            dots.append(n_)
    if bad_pb or mixed or inline_ach:
        rep.fail("rendered audience separation", "GM marker in player block(s) %s; mixed GM/player .md line(s) %s; inline GM note on achievement bullet line(s) %s" % (bad_pb, mixed, inline_ach))
    else:
        rep.ok("rendered audience separation", "%d player block(s) free of GM markers; no .md line mixes [GM-ONLY] with [PLAYER-FACING]; every achievement GM note is its own [GM-ONLY] bullet" % len(doc.get("audience_manifest", {}).get("player_blocks", [])))
    if dots:
        rep.warn("doubled full stop", "'..' in .md line(s) %s" % dots)
    else:
        rep.ok("doubled full stop", "no '..' artifacts in the rendered page")


def build(spec, data, rep):
    clock = spec["clock"]
    days = clock.get("days")
    daynum = spec["day"]["number"]
    ctx = {"budget_version": (spec.get("budget_file") or {}).get("version", "?"), "days": days, "day": daynum, "days_left": (days - daynum) if isinstance(days, int) else "?",
           "stasis_hours": clock.get("stasis_threshold_hours", "?"),
           "floor_hours": (days * 24) if isinstance(days, int) else "?"}
    spec = subst(spec, ctx)
    lint_spec = spec  # unresolved view: lints and the slot census run on what the spec itself says
    bud = data.budget
    b_errs, b_refs = [], set()
    if bud.data is None:
        rep.fail("budget file present", "%s missing or unreadable" % B70)
    else:
        pin = spec.get("budget_file", {}).get("expected_sha256")
        if pin and pin != bud.sha256:
            rep.warn("budget file hash", "spec pins %s but the file is %s (Syndicate changed it; re-check the cited paths, then update the pin)" % (pin[:12], bud.sha256[:12]))
        else:
            rep.ok("budget file present", "%s v%s, sha256 %s; every figure from it is a GM-adaptable guideline (authority_note)" % (
                B70, bud.data.get("version"), bud.sha256[:16]))
        spec = resolve_tree(copy.deepcopy(spec), bud, b_errs, b_refs)
        if b_errs:
            for m_ in b_errs:
                rep.fail("budget reference", m_)
        else:
            rep.ok("budget references resolve", "%d distinct field paths cited, all present in %s" % (len(b_refs), B70))

    # ---- clock
    if isinstance(days, int) and days >= 1:
        rep.ok("clock.days is a field", "clock.days=%d; page text uses {days}/{day}, nothing hard-coded" % days)
    else:
        rep.fail("clock.days is a field", "clock.days must be a positive integer")
    co = clock.get("collapse_order", [])
    if isinstance(days, int) and [c.get("day") for c in co] == list(range(1, days + 1)):
        rep.ok("collapse_order covers every day", "%d entries, days 1..%d, all tagged: %s" % (
            len(co), days, ", ".join(sorted({c.get("tag", "?") for c in co}))))
    else:
        rep.fail("collapse_order covers every day", "collapse_order must list days 1..clock.days")
    if isinstance(days, int) and 1 <= daynum <= days:
        rep.ok("day number in range", "Day %d of %d" % (daynum, days))
    else:
        rep.fail("day number in range", "day.number outside 1..clock.days")
    if isinstance(clock.get("short_rest_slots_per_day_cap"), int):
        rep.ok("short-rest cap field", "cap=%d per day (a cap, not a promise)" % clock["short_rest_slots_per_day_cap"])
    else:
        rep.fail("short-rest cap field", "missing integer short_rest_slots_per_day_cap")
    for k in ("collapse_cost_slot", "rest_without_saferoom_slot"):
        if not is_fill(clock.get(k)):
            rep.fail("clock fill %s" % k, "must be a budget reference or a bracketed slot")
    for k in ("final_day_end_slot", "collapse_miss_slot", "break_room_status_slot", "stasis_table_slot", "collapse_order_slot"):
        if k in clock:
            rep.fail("resolved item still a slot: %s" % k, "decision 026 (~9:45 PM CT) settled it; remove the slot and write the ruling")
    if clock.get("collapse_order_status"):
        rep.ok("collapse order status", clock["collapse_order_status"][:90])
    else:
        rep.fail("collapse order status", "clock.collapse_order_status required")
    fc = clock.get("final_collapse", {})
    if fc.get("hour_of_last_day") == 24 and "never ends the floor" in fc.get("text", "") and "cuts short" in fc.get("text", ""):
        rep.ok("final collapse fixed", "24 in-game hours into Day %s; a Long Rest never ends or skips the floor; rests that would run past it are cut short" % days)
    else:
        rep.fail("final collapse fixed", "clock.final_collapse needs hour_of_last_day=24 and text saying a Long Rest never ends the floor and the System cuts short a rest running past it")
    cm = clock.get("collapse_miss", {})
    cmt = (cm.get("text", "") + " " + cm.get("stasis_counts", "") + " " + cm.get("detour_tax_scope", ""))
    if (cm.get("death") is True and cm.get("reprieve_applies") is False and "dead" in cm.get("text", "") and "Reprieve" in cm.get("text", "")
            and "stasis" in cmt and "Detour Tax" in cmt and "missed Stairwell key" in cmt and "Caleb" in cm.get("status", "")
            and not cm.get("effects") and not cm.get("toll_slot")):
        rep.ok("missed-collapse rule", "death on every floor, Floor 1 included; no Reprieve; stasis counts as reaching a stairwell; Detour Tax is for a missed key only")
    else:
        rep.fail("missed-collapse rule", "clock.collapse_miss must be Caleb's ~10:02 PM CT ruling: death, no Reprieve, stasis counts, Detour Tax only for a missed key, no hauled-down/toll/Exhaustion effects")
    sr = clock.get("saferoom_rule", {})
    if data.floor == 1:  # Floor 1 layout: Break Room closes, the Green Room (z09) is the only saferoom to the end
        if sr.get("only_saferoom") == "z09" and sr.get("break_room_not_saferoom_from_day") and "Green Room" in sr.get("text", ""):
            rep.ok("saferoom rule", "Break Room not a saferoom from Day %s; the Green Room is the only saferoom to the end" % sr["break_room_not_saferoom_from_day"])
        else:
            rep.fail("saferoom rule", "clock.saferoom_rule needs only_saferoom=z09, break_room_not_saferoom_from_day, text naming the Green Room")
    elif sr.get("only_saferoom") and isinstance(sr.get("break_room_not_saferoom_from_day"), int) and len(str(sr.get("text", "")).strip()) >= 20:
        rep.ok("saferoom rule", "Floor %d: late-floor saferoom anchor %s; rule text set" % (data.floor, sr["only_saferoom"]))
    else:
        rep.fail("saferoom rule", "Floor %d: clock.saferoom_rule needs only_saferoom (zone id), break_room_not_saferoom_from_day (int, 99 = never) and text naming this floor's saferooms" % data.floor)
    if "Silver" in clock.get("achievement_caps", "") and "Story Box" in clock.get("achievement_caps", "") and "snark" in clock.get("achievement_caps", ""):
        rep.ok("achievement caps noted", "soft cap, Silver ceiling, one Story Box per floor, snark-only allowed")
    else:
        rep.fail("achievement caps noted", "clock.achievement_caps must mention the soft cap, Silver ceiling, Story Box limit and snark-only")
    zg = clock.get("zone_groups", "")
    if "inspired" in zg and "never cut" in zg:
        rep.ok("zone grouping confirmed", "outer/mid/Break Room/corridor groups set (inspired); route never cut")
    else:
        rep.fail("zone grouping confirmed", "clock.zone_groups must be the confirmed grouping, tagged inspired, saying the route is never cut")
    if isinstance(clock.get("stairwell_opens_day"), int) and isinstance(clock.get("stasis_threshold_hours"), int) \
            and clock.get("early_descent") and clock.get("stairwell_opens"):
        rep.ok("stairwell timing and early-descent rule filled", "opens Day %d; stasis if more than %d hours remain (canon M-276/M-277)" % (
            clock["stairwell_opens_day"], clock["stasis_threshold_hours"]))
    else:
        rep.fail("stairwell timing and early-descent rule filled", "need stairwell_opens_day, stasis_threshold_hours, stairwell_opens, early_descent")
    for lid in ("M-275", "M-276", "M-277"):
        if lid not in data.ledger and data.ledger:
            rep.fail("ledger id %s" % lid, "not in CANON-LEDGER.md")
    if re.search(r"decision 026|026-timed-floor-clock", clock.get("authority") or ""):
        rep.ok("clock cites decision 026")
    else:
        rep.fail("clock cites decision 026", "clock.authority must cite decision 026")

    # ---- Core Book Ch1 alignment (decision 031 / core v0.2.18 batch)
    blob_ = json.dumps(spec, ensure_ascii=False)
    stale_ = [s_ for s_ in ("Core section 5.6", "Core section 6 (", "pretty much game over") if s_ in blob_]
    rd_ = [m_.group(0) for m_ in re.finditer(r"real death[^\"]{0,80}", blob_) if "Reprieve" not in m_.group(0)]
    rn_ = [x_ for x_ in ((spec["day"].get("early_descent") or {}).get("reprieve_note"), spec.get("stairwell_key", {}).get("reprieve_note")) if x_]
    if stale_ or rd_ or len(rn_) != 1 or not all("Reprieve" in x_ and "descend" in x_ and x_.startswith(GM) for x_ in rn_):
        rep.fail("Core Book Ch1 alignment", "stale pointers %s; unqualified 'real death' %s; Reprieve-expiry GM notes found %d (need exactly one, starting [GM-ONLY])" % (stale_, rd_, len(rn_)))
    else:
        rep.ok("Core Book Ch1 alignment", "no old Core section pointers; fight deaths name the unused Reprieve; one [GM-ONLY] Reprieve-expiry note on the early-descent block")
    # ---- achievements catalog pin (optional; tables/achievements.csv)
    acp = spec.get("achievements_catalog", {}).get("expected_sha256")
    if acp and acp != data.ach_sha256:
        rep.warn("achievements catalog hash", "spec pins %s but tables/achievements.csv is %s (Syndicate revised it; check the cited rows, then update the pin)" % (acp[:12], data.ach_sha256[:12]))
    elif acp:
        rep.ok("achievements catalog pinned", "tables/achievements.csv v%s, sha256 %s, %d rows" % (spec["achievements_catalog"].get("version", "?"), data.ach_sha256[:16], len(data.ach)))
    # ---- canon table
    if data.canon:
        rep.ok("Lore canon table present", "%s (ledger %s, %d zones)" % (
            data.canon_display, data.canon.get("ledger_version"), len(data.canon["zones"])))
        pin = spec.get("canon_table", {}).get("expected_sha256")
        if pin and pin != data.canon_sha256:
            rep.warn("canon table hash", "spec pins %s but the file is %s (Lore rebuilt it; check ledger/content, then update the pin)" % (pin[:12], (data.canon_sha256 or "?")[:12]))
        else:
            rep.ok("canon table hash recorded", "sha256 %s, ledger v%s" % ((data.canon_sha256 or "?")[:16], data.canon.get("ledger_version")))
    else:
        rep.warn("Lore canon table present", "%s not found; canon tags omitted" % data.canon_display)

    def check_ledger(lid, where):
        if lid in data.ledger:
            return True
        if data.ledger:
            rep.fail("ledger id %s" % lid, "not a row in CANON-LEDGER.md (%s)" % where)
        else:
            rep.warn("ledger id %s" % lid, "ledger unreadable (%s)" % where)
        return False

    def resolve_ach(a, where):
        r = data.ach.get(a["id"])
        if not r:
            rep.fail("achievement id", "%s (%s) not in tables/achievements.csv" % (a["id"], where))
            return dict(a, name=None, valid=False)
        out = dict(a, name=r["Name"], rarity=r["Rarity"], floor=r["Floor"], label=data.ach_label(r), valid=True)
        if a.get("canon_ledger_id"):
            lid = a["canon_ledger_id"]
            check_ledger(lid, where)
            out["canon_ledger_name"] = data.ledger.get(lid, "")
            if data.ach_by_canon.get(lid) != a["id"]:
                rep.fail("achievement canon lineage", "%s (%s): catalog row does not cite canon %s in its Notes" % (a["id"], where, lid))
        return out

    def resolve_canon_ref(c, where):
        check_ledger(c["ledger_id"], where)
        name = data.ledger.get(c["ledger_id"], "")
        in_csv = (name.strip().lower() in data.ach_names or c["ledger_id"] in data.ach_by_canon) if c["ledger_id"].startswith("A-") else None
        out = dict(c, ledger_name=name)
        if c["ledger_id"] in data.ach_by_canon:
            out["catalog_id"] = data.ach_by_canon[c["ledger_id"]]
        if in_csv is not None:
            out["in_achievements_csv"] = in_csv
            if not in_csv:
                out["status"] = "canon reference only (not a row in tables/achievements.csv)"
        return out

    # ---- routes
    routes = []
    tags_seen = set()
    for r in spec["routes"]:
        tags_seen.add(r.get("tag"))
        vl = r.get("voice_lines", {})
        miss = [k for k in VOICE_KEYS if k not in vl or vl[k].get("tag") != PF or not vl[k].get("text")]
        miss += [k for k in vl if k not in VOICE_KEYS and k not in OPTIONAL_VOICE_KEYS]
        for k, v in vl.items():
            want = "[GM-FACING]" if k == "gm_color" else PF
            if v.get("tag") != want:
                miss.append(k)
        if miss:
            rep.fail("route %s voice lines" % r["id"], "missing or untagged %s" % sorted(set(miss)))
        rr = dict(r)
        rr["achievements"] = [resolve_ach(a, r["id"]) for a in r.get("achievements", [])]
        rr["canon_refs"] = [resolve_canon_ref(c, r["id"]) for c in r.get("canon_refs", [])]
        routes.append(rr)
    if set(TAGS) <= tags_seen and len(routes) >= 3:
        rep.ok("three routes (dash, loot, clever)", "%d routes, each with System intro/midpoint/win [PLAYER-FACING]" % len(routes))
    else:
        rep.fail("three routes (dash, loot, clever)", "need dash, loot and clever routes; have %s" % sorted(tags_seen))

    # ---- stairwell key
    sk = dict(spec["stairwell_key"])
    ways = sk.get("ways", [])
    if len({w.get("id") for w in ways}) >= 2 and all(w.get("how") and w.get("where") for w in ways):
        rep.ok("Stairwell key findable 2+ ways", "%d ways: %s" % (len(ways), ", ".join(w["id"] for w in ways)))
    else:
        rep.fail("Stairwell key findable 2+ ways", "need at least two distinct ways with how/where")
    if sk.get("missing_key_cost", {}).get("instant_wipe") is False and is_fill(sk["missing_key_cost"].get("toll_slot")):
        rep.ok("missing key is a cost, not a wipe", "instant_wipe=false; the Detour Tax toll is cited from the budget file")
    else:
        rep.fail("missing key is a cost, not a wipe", "missing_key_cost.instant_wipe must be false and toll_slot a slot")
    if not sk.get("availability") or not sk.get("early_descent"):
        rep.fail("stairwell availability and early-descent text", "stairwell_key.availability and .early_descent are required")
    for n in sk.get("canon_stairwell_notes", []):
        check_ledger(n["ledger_id"], "stairwell note")
    # key deadlines vs collapse order
    ev = {c["day"]: c["event"].lower() for c in co}
    avail_today = []
    for w in ways:
        lost = w.get("lost_on_day")
        if lost is not None:
            expect = {"key-bruiser": "mid zones", "key-terminal": "break room"}.get(w["id"])
            if not isinstance(lost, int) or (expect and expect not in ev.get(lost, "")):
                rep.fail("key deadline %s" % w["id"], "lost_on_day=%s does not match the collapse step that removes it (%s)" % (lost, expect))
        w["status_today"] = "available" if (lost is None or daynum < lost) else "LOST (hooks in a closed zone or a dark vendor; only if not already taken)"
        if w["status_today"] == "available":
            avail_today.append(w["id"])
    rep.ok("key availability today", "Day %d: %s" % (daynum, ", ".join(avail_today) or "no key way left (keyless forcing or toll)"))

    # ---- day-level blocks
    dd = spec["day"]
    early = dict(dd.get("early_descent", {}))
    opens = clock.get("stairwell_opens_day")
    step = ev.get(daynum, "")
    if not step.startswith("nothing"):
        cn = dd.get("collapse_notice", {})
        if cn.get("tag") == PF and cn.get("text") and "Lore" in cn.get("status", "") and cn.get("canon_tag") == "inspired" \
                and "PLACEHOLDER" not in cn["text"] + cn.get("status", ""):
            if "{hours}" in cn["text"] and not cn.get("hours_note"):
                rep.fail("collapse notice", "text has {hours}; add hours_note telling the GM to fill it from the clock")
            else:
                rep.ok("collapse notice", "Lore's wording, [PLAYER-FACING], tagged inspired%s" % (" ({hours} filled by the GM)" if "{hours}" in cn["text"] else ""))
        else:
            rep.fail("collapse notice", "needs Lore's wording (no PLACEHOLDER), PF tag, status naming Lore, canon_tag inspired")
    if daynum == opens:
        so = dd.get("stairwell_opening", {})
        if so.get("tag") == PF and so.get("text"):
            rep.ok("stairwell-opening announcement", "present on Day %d" % daynum)
        else:
            rep.fail("stairwell-opening announcement", "required on the day the stairwell opens")
    if isinstance(opens, int) and daynum >= opens:
        ep = early.get("player_prompt", {})
        if ep.get("tag") == PF and ep.get("text") and early.get("gm_override_note") and early.get("canon_refs") \
                and "sideline" in early.get("sideline_note", "") and not early.get("slots"):
            early["canon_refs"] = [resolve_canon_ref(c, "early_descent") for c in early["canon_refs"]]
            early["achievements"] = [resolve_ach(a, "early_descent") for a in early.get("achievements", [])]
            rep.ok("early-descent stasis handling", "player prompt [PLAYER-FACING], canon refs, GM override note and sideline-scenes note present")
        else:
            rep.fail("early-descent stasis handling", "needs player_prompt (PF), canon_refs, gm_override_note and the stasis sideline_note (decision 026 ruling 4)")
    if isinstance(days, int) and daynum == days:
        fe = dd.get("floor_exit", {})
        sl = fe.get("system_line", {})
        gw = fe.get("gm_warning", {})
