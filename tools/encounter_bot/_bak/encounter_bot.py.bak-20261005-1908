    fh_bad = [x["id"] for x in spec["encounters"] if not any(str(g).startswith("Floor hour") and "24 in-game hours" in str(g) for g in x.get("carry_on", {}).get("gm_tracks", []))]
    if fh_bad:
        rep.fail("floor-hour tracker", "GM tracks need a 'Floor hour' running-count line (hours elapsed vs the fixed 24-hour final collapse, overview section 2 rule 6) on: %s" % ", ".join(fh_bad))
    else:
        rep.ok("floor-hour tracker", "every encounter's GM tracks carry the running floor-hour count against the fixed 24-hour final collapse")
    if zc_bad:
        rep.fail("zone color", "needs tag inspired and [PLAYER-FACING] lines: %s" % ", ".join(zc_bad))
    longq = [p for p, s in full for q in re.findall(r'"([^"]+)"', s) if len(q.split()) > 25]
    rep.ok("any quote is 25 words or fewer") if not longq else rep.fail("quote length", ", ".join(longq))

    # ---- pending inputs
    pend = spec.get("pending_inputs", [])
    owners = " ".join(p["owner"] for p in pend)
    items = " ".join(p["item"] for p in pend)
    if "Syndicate" in owners and "Lore" in owners and "rules/70-encounter-budget-5e.json" in items and "clock.days" in items:
        rep.ok("Pending inputs section", "%d entries: budget file, clock numbers, collapse zone groups/costs, canon table, day-count field" % len(pend))
    else:
        rep.fail("Pending inputs section", "must list Syndicate (budget file, clock numbers), Lore (collapse, canon table) and clock.days")

    slots = []
    for p, s in full:
        for m in SLOT_RE.finditer(s):
            lab = m.group(1)
            slots.append({"label": lab, "text": m.group(0), "path": p, "kind": "proposal" if lab.startswith("PROPOSAL") else "slot"})
    # proposals written as plain "PROPOSAL" text also count
    proposals = sorted({p for p, s in full if "PROPOSAL" in s and not SLOT_RE.search(s)})

    doc = {
        "schema": "encounter-bot-day/0.1",
        "meta": dict(spec["meta"], day=daynum, days=days, days_left=ctx["days_left"],
                     generated_by="tools/encounter_bot/encounter_bot.py (pure local Python 3, no model/API calls)",
                     canon_table_sha256=data.canon_sha256, achievements_csv_sha256=data.ach_sha256, canon_ledger_version=(data.canon or {}).get("ledger_version"),
                     budget_file=B70, budget_file_version=(bud.data or {}).get("version"), budget_file_sha256=bud.sha256,
                     budget_file_label="every figure from the budget file is a GM-adaptable guideline (its authority_note)"),
        "clock": spec["clock"],
        "canon_table": dict(spec.get("canon_table", {}), present=bool(data.canon),
                            schema=(data.canon or {}).get("schema"), ledger_version=(data.canon or {}).get("ledger_version"),
                            sha256=data.canon_sha256),
        "day": dict(spec["day"], last_chance_hooks=last, proposed_achievements=day_prop, **({"early_descent": early} if early else {})),
        "routes": routes,
        "stairwell_key": sk,
        "encounters": encs,
        "pending_inputs": pend,
        "slots": slots,
        "proposal_fields": proposals,
    }
    add_audience(doc, rep)
    return doc


# ---------------------------------------------------------------- markdown
def bullets(items, indent=""):
    return "".join("%s- %s\n" % (indent, i) for i in items)


def gm(note):
    return note if note.startswith(GM) or "[GM-ONLY]" in note else "%s %s" % (GM, note)


def join_sentence(*parts):
    """Join prose pieces with single spaces and never leave a doubled full stop ('..'); a real ellipsis is kept."""
    out = ""
    for p_ in parts:
        p_ = (p_ or "").strip()
        if not p_:
            continue
        if out.endswith(".") and not out.endswith("...") and p_.startswith("."):
            p_ = p_[1:].lstrip()
        out = (out + " " + p_) if out else p_
    return out


def end_stop(s):
    s = (s or "").rstrip()
    return s if not s or s[-1] in ".!?)\"" else s + "."


def ach_line(a):
    """Achievement text WITHOUT its GM note; the note goes on its own bullet (ach_gm_bullets)."""
    s = "%s: %s" % (a.get("label", a["id"]), a["note"])
    if a.get("canon_ledger_id"):
        s += " (catalog row for canon %s)" % a["canon_ledger_id"]
    return s


def ach_gm_bullets(achs, what="Achievement"):
    """One separate [GM-ONLY] bullet per achievement GM note; never inline with player text or the achievement line."""
    out = []
    for a in achs or []:
        if a.get("gm_note"):
            note = a["gm_note"].strip()
            if note.startswith(GM):
                note = note[len(GM):].strip()
            out.append("- %s %s %s: %s" % (GM, what, a["id"], end_stop(note)))
    return out


def render_proposed(pa):
    s = "**Proposed achievement** *%s* [%s]: trigger: %s" % (pa["name"], pa["tag"], pa["trigger"])
    if pa.get("narration"):
        s += " Narration %s: \"%s\"" % (pa["narration_tag"], pa["narration"])
    if pa.get("canon_ref"):
        s += " Canon parallel: %s \"%s\" (reference only)." % (pa["canon_ref"]["ledger_id"], pa["canon_ref"]["ledger_name"])
    if pa.get("catalog_parallel"):
        cp = pa["catalog_parallel"]
        s = join_sentence(s, "Catalog parallel: %s." % cp.get("label", cp["id"]).rstrip("."))
    return join_sentence(s, "Reward (guideline, GM may adapt): %s" % fill_text(pa["reward_slot"]))


def render_proposed_lines(pa):
    """The proposal bullet (may carry [PLAYER-FACING] narration) plus any GM note as its OWN [GM-ONLY] bullet."""
    lines = ["- " + render_proposed(pa)]
    cp = pa.get("catalog_parallel")
    if cp and cp.get("gm_note"):
        lines += ach_gm_bullets([dict(cp, id="%s (catalog parallel of proposed %s)" % (cp["id"], pa["name"]))], "Achievement")
    return lines


