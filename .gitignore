# FULL backup repo. Caleb authorized a full backup on 2026-10-04: gm-notes (incl. secret), sessions, ledgers,
# state, player sheets, logs and exports ARE tracked. Only live credentials and dependency/cache junk stay out.
# (backup-push.sh uses `git add -A --force`; the real filter is ops/backup-sync.py + ops/check_repo_safe.py.)

# live credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# engine session database (live state; not content)
engine-data/

# dependencies / caches
node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store

# Path aliases recreated by the Cloud Agent install. The git root is the
# flattened backup; the GM tools and voice bridge still look up
# /workspace/dcc-campaign (decisions, sessions, tools) and /workspace/dcc-lore.
/dcc-campaign/
/dcc-lore

# Per-machine #agents poll cursors / lastseen (runtime; changes often). backup-sync excludes these.
lore/state/agents-channel-last.txt
sessions/agents-channel-*.txt
sessions/agents-channel-*.lastseen
sessions-data/*/agents-channel-*.txt
sessions-data/*/agents-channel-*.lastseen
